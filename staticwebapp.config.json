{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/assets/*", "/icons/*", "*.js", "*.css", "*.png", "*.jpg", "*.svg", "*.ico", "*.webmanifest"]
  },
  "routes": [
    {
      "route": "/api/activate",
      "methods": ["POST"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/getFoodItems",
      "methods": ["GET"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/storeFoodItem",
      "methods": ["POST"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/updateFoodItem",
      "methods": ["PUT"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/deleteFoodItem",
      "methods": ["DELETE"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/getStores",
      "methods": ["GET"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/storeStore",
      "methods": ["POST"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/updateStore",
      "methods": ["PUT"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/deleteStore",
      "methods": ["DELETE"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/getList",
      "methods": ["GET"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/addListItem",
      "methods": ["POST"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/updateListItem",
      "methods": ["PUT"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/deleteListItem",
      "methods": ["DELETE"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/clearChecked",
      "methods": ["POST"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/bulkUpdateCategory",
      "methods": ["PUT"],
      "allowedRoles": ["anonymous"]
    }
  ],
  "globalHeaders": {
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; worker-src 'self'"
  },
  "responseOverrides": {
    "401": {
      "statusCode": 401,
      "body": "Unauthorized"
    },
    "404": {
      "rewrite": "/index.html"
    }
  },
  "platform": {
    "apiRuntime": "node:22"
  }
}
