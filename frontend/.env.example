# Frontend build-time configuration (Vite). Copy to .env.local to override.
# All values are optional; the defaults work for the standard SWA deployment.

# Base URL for API calls. Defaults to the same-origin "/api", which is correct
# when the frontend and Azure Functions are served by the same Static Web App.
# Only set this if the API is hosted elsewhere.
# VITE_API_BASE=/api

# Polling interval in milliseconds for the shared list/food/store data.
# Defaults to 60000 (60s). See frontend/src/config.ts.
# VITE_REFRESH_INTERVAL=60000
