{
  "name": "shopping-assistant-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync-types": "node -e \"require('fs').cpSync('../shared/types.ts','src/types/shared.ts')\"",
    "predev": "npm run sync-types",
    "dev": "vite",
    "prebuild": "npm run sync-types",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretest": "npm run sync-types",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^24.1.3",
    "typescript": "^5.6.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
